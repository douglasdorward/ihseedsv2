{
  "name": "@workspace/claude-design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "PORT=${PORT:-4173} BASE_PATH=/admin/ vite build",
    "serve": "vite preview",
    "typecheck": "pnpm run typecheck:clerk-contract && tsc -p tsconfig.json --noEmit",
    "typecheck:clerk-contract": "tsc -p tsconfig.clerk-contract.json --noEmit"
  },
  "dependencies": {
    "@clerk/react": "6.15.2",
    "@clerk/themes": "^2.4.0",
    "@tanstack/react-query": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^6.0.7"
  }
}
