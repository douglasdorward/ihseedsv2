{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm --filter @workspace/claude-design run build && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "pnpm run backfill:media && node --enable-source-maps ./dist/index.mjs",
    "backfill:media": "tsx ./scripts/backfill-media-library.ts",
    "typecheck": "pnpm --filter @workspace/db exec tsc --build --force && tsc -p tsconfig.json --noEmit",
    "test:auth": "pnpm run build && pnpm --filter @workspace/db run migrate && node --test ./test/admin-auth.test.mjs",
    "test:admin-login-browser": "pnpm --filter @workspace/claude-design run build && pnpm run build && node --test ./test/admin-login-browser.test.mjs",
    "test:admin-password-recovery-browser": "pnpm --filter @workspace/claude-design run build && pnpm run build && node --test ./test/admin-password-recovery-browser.test.mjs",
    "test:clerk-proxy": "tsx --test ./test/clerk-proxy.test.ts",
    "test:lifecycle": "node ./scripts/run-lifecycle-tests.mjs",
    "test:media": "tsx --test ./test/media-image-validation.test.ts ./test/image-alt.test.ts ./test/media-usage.test.ts && node --test ./test/media-library.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "@clerk/shared": "^4.31.1",
    "@google-cloud/storage": "^8.1.0",
    "@replit/object-storage": "^1.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.4",
    "tsx": "catalog:",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
