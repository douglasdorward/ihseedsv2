# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules
.pnpm-store/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db
.env
.env.rtf
.env.local

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
artifacts/web/.next-lifecycle/

# Runtime copy of API uploads when the server is started from the repo root
/uploads/

# Admin product photo uploads
artifacts/api-server/uploads/products/*
!artifacts/api-server/uploads/products/.gitkeep
artifacts/api-server/uploads/tech-sheets/*
!artifacts/api-server/uploads/tech-sheets/.gitkeep
artifacts/api-server/uploads/media/*
!artifacts/api-server/uploads/media/.gitkeep
artifacts/api-server/uploads/site/hero-videos/

# Cursor debug logs
.cursor/debug-*.log
